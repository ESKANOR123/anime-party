# Dependencies
node_modules/
.pnp
.pnp.js

# Storage (uploaded videos and thumbnails should not be committed to Git due to size limits)
server/storage/videos/*
!server/storage/videos/.gitkeep
server/storage/thumbnails/*
!server/storage/thumbnails/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment & OS
.env
.env.local
.DS_Store
Thumbs.db
